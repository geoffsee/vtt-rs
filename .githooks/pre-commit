#!/usr/bin/env bash
# Fast checks before commit (mirrors CI Format job).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found on PATH" >&2
  exit 1
fi

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check
