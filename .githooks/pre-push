#!/usr/bin/env bash
# Full CI parity checks before push.
# Mirrors .github/workflows/ci.yml: Format, Clippy, Test, Documentation.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-push: cargo not found on PATH" >&2
  exit 1
fi

run() {
  echo "pre-push: $*"
  "$@"
}

run cargo fmt --all -- --check
run cargo clippy --all-targets --all-features -- -D warnings
run cargo test --all-features
run cargo test --doc --all-features
RUSTDOCFLAGS="-D warnings" run cargo doc --no-deps --all-features --document-private-items

echo "pre-push: all CI checks passed"
